Backport of upstream lpac 977c324: fix(driver): 'json_request' interface was changed in b23f0e4 (#399)
https://github.com/estkme-group/lpac/commit/977c32431bac71adbb3aad7d4124e3154f9bdf93

json_request() returns true on success, but v2.3.0 treated true as failure, so the
stdio APDU driver could not connect, open a channel or transmit at all. The agent
drives lpac through this driver.

diff --git a/driver/apdu/stdio.c b/driver/apdu/stdio.c
index f7a192d..bd3de58 100644
--- a/driver/apdu/stdio.c
+++ b/driver/apdu/stdio.c
@@ -159,7 +159,7 @@ exit:
 static int apdu_interface_connect(struct euicc_ctx *ctx) {
     int ecode;
 
-    if (json_request("connect", NULL, 0)) {
+    if (!json_request("connect", NULL, 0)) {
         return -1;
     }
 
@@ -182,7 +182,7 @@ static void apdu_interface_disconnect(struct euicc_ctx *ctx) {
 static int apdu_interface_logic_channel_open(struct euicc_ctx *ctx, const uint8_t *aid, uint8_t aid_len) {
     int ecode;
 
-    if (json_request("logic_channel_open", aid, aid_len)) {
+    if (!json_request("logic_channel_open", aid, aid_len)) {
         return -1;
     }
 
@@ -208,7 +208,7 @@ static int apdu_interface_transmit(struct euicc_ctx *ctx, uint8_t **rx, uint32_t
                                    uint32_t tx_len) {
     int ecode;
 
-    if (json_request("transmit", tx, tx_len)) {
+    if (!json_request("transmit", tx, tx_len)) {
         return -1;
     }
 
